<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="12" SnapsToDevicePixels="True">
    <Grid.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF2FB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#AEBBD2"/>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Background" Value="#354054"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#C8D4E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="7" BorderThickness="1" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#303A4D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#91B8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#43516A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <Border CornerRadius="16" Background="#171C27" IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect Color="#060910" BlurRadius="22" ShadowDepth="3" Opacity="0.37"/>
        </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="#171C27" BorderBrush="#394255"
            BorderThickness="1" Padding="12,8" RenderOptions.ClearTypeHint="Enabled">
    <StackPanel>
        <Grid x:Name="StatusBar" Height="45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="47"/>
                <ColumnDefinition Width="128"/>
                <ColumnDefinition Width="114"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="33"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="10" Background="#26374F" ToolTip="Codex 用量">
                <Path Stroke="#A2C7FF" StrokeThickness="1.8" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M2,12 L6,12 L9,5 L12,16 L16,9 L20,9"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="会话累计" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="Total" Text="—" Style="{StaticResource Number}"/>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Separator}"/>
            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="缓存命中" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="Hit" Text="—" Style="{StaticResource Number}" Foreground="#8CE4BE"/>
            </StackPanel>
            <Border Grid.Column="3" Style="{StaticResource Separator}"/>
            <StackPanel Grid.Column="3" Margin="14,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="上下文占用" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Context" Text="—" Width="59" Style="{StaticResource Number}"/>
                    <Border Background="#354054" Width="70" Height="4" CornerRadius="2" VerticalAlignment="Center">
                        <Border x:Name="Fill" Background="#9DC3FF" Width="0" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Button x:Name="Toggle" Grid.Column="4" Width="34" Height="30" Background="#252E40"
                    AutomationProperties.Name="展开明细" ToolTip="明细">
                <Path x:Name="Chevron" Stroke="#D1DDF3" StrokeThickness="1.7" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1 L6,6 L11,1"/>
            </Button>
            <Button x:Name="Dismiss" Grid.Column="5" Width="30" Height="30" HorizontalAlignment="Right"
                    AutomationProperties.Name="关闭" ToolTip="关闭">
                <Path Stroke="#AEBBD2" StrokeThickness="1.7" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Data="M1,1 L10,10 M10,1 L1,10"/>
            </Button>
        </Grid>
        <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,8,0,3">
            <Border Height="1" Background="#354054" Margin="0,0,0,13"/>
            <Grid Margin="3,0,3,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前模型" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="Model" Text="—" Style="{StaticResource Number}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="已用 / 会话有效窗口" Style="{StaticResource Caption}" TextAlignment="Right"/>
                    <TextBlock x:Name="WindowSize" Text="—" Style="{StaticResource Number}" FontSize="14" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
            <Border Background="#222B3B" CornerRadius="10" Padding="10,9">
                <UniformGrid Columns="5">
                    <StackPanel>
                        <TextBlock Text="输入" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="Input" Style="{StaticResource Number}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="未缓存输入" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="Uncached" Style="{StaticResource Number}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="缓存读取" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="Read" Style="{StaticResource Number}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="报告的写入" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="Write" Style="{StaticResource Number}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="输出" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="Output" Style="{StaticResource Number}" FontSize="14"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
            <DockPanel Margin="3,9,0,0" LastChildFill="True">
                <Button x:Name="SelectSession" DockPanel.Dock="Right" Background="#252E40"
                        Content="切换会话" AutomationProperties.Name="切换会话"/>
                <TextBlock x:Name="SessionName" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
            </DockPanel>
            <StackPanel x:Name="Picker" Visibility="Collapsed" Margin="0,9,0,0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="PasteLink" DockPanel.Dock="Right" Content="粘贴链接"
                            Background="#252E40" Margin="8,0,0,0"/>
                    <TextBox x:Name="SessionQuery" Height="32" VerticalContentAlignment="Center"
                             Background="#20293A" Foreground="#EDF2FB" CaretBrush="#EDF2FB"
                             BorderBrush="#465570" BorderThickness="1" Padding="8,0"
                             AutomationProperties.Name="搜索会话标题、项目或粘贴会话链接"/>
                </DockPanel>
                <TextBlock x:Name="PickerHint" Text="搜索标题、项目，或粘贴 Codex 会话链接" Style="{StaticResource Caption}"
                           Margin="3,7,0,6" TextWrapping="Wrap"/>
                <ListBox x:Name="SessionResults" Height="153" Background="#1B2331" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="会话搜索结果">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Margin="3,1" CornerRadius="3" Background="#60708A"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" Padding="6,4" CornerRadius="6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#29364A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#314663"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="#EDF2FB" FontSize="13"/>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <Button x:Name="FollowRecent" Content="自动跟随最近活动" DockPanel.Dock="Left"/>
                    <Button x:Name="UseSession" Content="使用选中会话" DockPanel.Dock="Right" Background="#314663"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
    </Border>
</Grid>
